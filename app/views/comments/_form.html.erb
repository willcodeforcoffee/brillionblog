<%= form_with model: comment, url: post_comments_path(post), class: "contents" do |form| %>
  <% if comment.errors.any? %>
    <div class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg" id="error_explanation">
      <ul class="list-disc list-inside">
        <% comment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% unless authenticated? %>
    <div class="my-4 grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :guest_name, "Name", class: "block font-medium" %>
        <%= form.text_field :guest_name, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      </div>
      <div>
        <%= form.label :guest_email, "Email (not published)", class: "block font-medium" %>
        <%= form.email_field :guest_email, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      </div>
    </div>
  <% end %>

  <div class="my-4">
    <%= form.label :body, "Comment", class: "block font-medium" %>
    <%= form.text_area :body, required: true, rows: 4, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <%= form.submit "Post comment", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
<% end %>
