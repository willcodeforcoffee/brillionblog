<div class="mx-auto md:w-2/3 w-full">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block"><%= notice %></p>
  <% end %>

  <% if @post.draft? %>
    <span class="text-sm font-medium text-yellow-600">Draft</span>
  <% end %>

  <h1 class="font-bold text-4xl"><%= @post.title %></h1>
  <p class="text-sm text-gray-500 mt-2">
    By <%= @post.authors.map(&:name).to_sentence %>
    <% if @post.published? %>
      &middot; <%= @post.published_at.to_fs(:long) %>
    <% end %>
  </p>

  <% if authenticated? %>
    <div class="mt-4 flex items-center gap-4 text-sm">
      <%= link_to "Edit", edit_post_path(@post), class: "text-blue-600 underline hover:no-underline" %>
      <%= link_to "History", post_versions_path(@post), class: "text-blue-600 underline hover:no-underline" %>
      <%= button_to "Delete", post_path(@post), method: :delete, class: "text-red-600 underline hover:no-underline", form: { data: { turbo_confirm: "Delete this post?" } } %>
    </div>
  <% end %>

  <div class="mt-6">
    <%= @post.content %>
  </div>

  <div class="mt-10 border-t pt-6">
    <h2 class="font-bold text-2xl">Comments</h2>

    <% if @post.comments.empty? %>
      <p class="text-gray-500 mt-2">No comments yet.</p>
    <% else %>
      <div class="mt-4 divide-y">
        <%= render @post.comments %>
      </div>
    <% end %>

    <% if @post.comments_allowed? %>
      <div class="mt-6">
        <%= render "comments/form", post: @post, comment: @comment %>
      </div>
    <% else %>
      <p class="text-gray-500 mt-6">Comments are disabled for this post.</p>
    <% end %>
  </div>
</div>
